# LAN File Search System Configuration

# Paths
WATCH_FOLDER=./documents
DATA_FOLDER=./data

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: Gemini Configuration (if using Gemini)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# VLM Configuration (Vision Language Model for document extraction)
VLM_PROVIDER=ollama
USE_VLM_EXTRACTION=true
VLM_FALLBACK_OCR=true

# Ollama VLM settings (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT=120.0

# Optional: HuggingFace VLM settings (cloud inference - faster alternative)
# VLM_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here
# HUGGINGFACE_VLM_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
# HUGGINGFACE_TIMEOUT=60.0

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES=2000

# Search Configuration
SEARCH_TOP_K=10
HYBRID_ALPHA=0.5

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_PATH=./data/sqlite/metadata.db

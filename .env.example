# =============================================================================
# LAN File Search System - Complete Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# PATH SETTINGS
# -----------------------------------------------------------------------------
WATCH_FOLDER=./documents
DATA_FOLDER=./data
DATABASE_PATH=./data/sqlite/metadata.db

# -----------------------------------------------------------------------------
# LLM CONFIGURATION
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai  # Options: openai, gemini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# VLM CONFIGURATION (Vision Language Model)
# -----------------------------------------------------------------------------
VLM_PROVIDER=ollama  # Options: ollama, huggingface
USE_VLM_EXTRACTION=true
VLM_FALLBACK_OCR=true

# Ollama VLM settings (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT=120.0

# HuggingFace VLM settings (cloud inference)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct:fireworks-ai
HUGGINGFACE_TIMEOUT=60.0

# -----------------------------------------------------------------------------
# BOX FILTERING (Layout Detection)
# -----------------------------------------------------------------------------
BOX_FILTER_ENABLED=true
BOX_FILTER_CONTAINMENT_THRESHOLD=0.85
BOX_FILTER_IOU_THRESHOLD=0.5
BOX_FILTER_CLASS_AGNOSTIC=true
BOX_FILTER_USE_SOFT_NMS=true
BOX_FILTER_SOFT_NMS_SIGMA=0.3

# -----------------------------------------------------------------------------
# EMBEDDING CONFIGURATION
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-mpnet-base-v2  # Options: all-mpnet-base-v2, all-MiniLM-L6-v2
EMBEDDING_DIMENSION=768

# -----------------------------------------------------------------------------
# CHUNKING CONFIGURATION
# -----------------------------------------------------------------------------
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MAX_CHUNK_SIZE=2500
ENABLE_SEMANTIC_CHUNKING=true
SEMANTIC_SIMILARITY_THRESHOLD=0.72  # Lowered from 0.80 for better topic detection
ENABLE_CHUNK_LINKS=true  # Enable cross-chunk context

# -----------------------------------------------------------------------------
# ENRICHMENT CONFIGURATION
# -----------------------------------------------------------------------------
ENRICHMENT_BATCH_SIZE=5
QUESTIONS_PER_CHUNK=5  # Increased from 3

# -----------------------------------------------------------------------------
# SEARCH CONFIGURATION
# -----------------------------------------------------------------------------
SEARCH_TOP_K=10

# RRF (Reciprocal Rank Fusion) Settings
RRF_K_CONSTANT=30  # Lower value = better discrimination (was hardcoded 60)

# Multi-Vector Weights (must sum to ~1.0)
MULTI_VECTOR_WEIGHTS_MAIN=0.40
MULTI_VECTOR_WEIGHTS_QUESTION=0.20
MULTI_VECTOR_WEIGHTS_BM25=0.25
MULTI_VECTOR_WEIGHTS_SUMMARY=0.15

# -----------------------------------------------------------------------------
# HYDE (Hypothetical Document Embeddings) CONFIGURATION
# -----------------------------------------------------------------------------
ENABLE_HYDE=true
HYDE_NUM_HYPOTHETICALS=1
HYDE_ALPHA=0.5  # Configurable alpha (was hardcoded 0.6)
HYDE_ALPHA_MIN=0.3  # For adaptive alpha
HYDE_ALPHA_MAX=0.6  # For adaptive alpha
HYDE_ADAPTIVE=true  # Enable adaptive alpha based on query

# -----------------------------------------------------------------------------
# CACHE CONFIGURATION
# -----------------------------------------------------------------------------
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES=2000

# -----------------------------------------------------------------------------
# RE-RANKING CONFIGURATION
# -----------------------------------------------------------------------------
RERANKER_ENABLED=false  # Enable cross-encoder re-ranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=20  # Re-rank top 20, return top k
RERANKER_BLEND_RATIO=0.7  # 70% reranker + 30% original score

# -----------------------------------------------------------------------------
# MMR (Maximum Marginal Relevance) CONFIGURATION
# -----------------------------------------------------------------------------
MMR_ENABLED=false  # Enable diversity-aware ranking
MMR_LAMBDA=0.7  # 0.7 = 70% relevance, 30% diversity

# -----------------------------------------------------------------------------
# BM25 CONFIGURATION
# -----------------------------------------------------------------------------
BM25_EXPAND_SYNONYMS=true  # Enable insurance-specific synonyms
BM25_MIN_TOKEN_LENGTH=2

# -----------------------------------------------------------------------------
# QUERY PROCESSING CONFIGURATION
# -----------------------------------------------------------------------------
QUERY_EXPAND_SYNONYMS=true
QUERY_SPELL_CHECK=false  # Optional spell correction

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
